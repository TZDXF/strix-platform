# docker compose 部署环境变量（复制为 .env 后填写）

# 共享访问令牌（必填，自定义随机串）
API_TOKEN=

# 公司 LLM 网关（必填）
LLM_API_BASE=
LLM_API_KEY=
STRIX_LLM=free

# RustFS 对象存储密钥（建议修改默认值）
RUSTFS_ACCESS_KEY=strix-platform
RUSTFS_SECRET_KEY=strix-platform-secret

# PostgreSQL 密码（建议修改默认值）
POSTGRES_PASSWORD=strix

# 黑盒目标允许清单（逗号分隔：域名后缀 或 CIDR，如 .test.company.internal,10.0.0.0/8）
TARGET_ALLOWLIST=
