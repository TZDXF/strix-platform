# docker compose 部署环境变量（复制为 .env 后填写）

# 登录会话签名密钥（必填，自定义长随机串；泄露等于所有账号可被伪造）
SECRET_KEY=
# 初始超管密码（仅用户库为空的首次启动时生效，账号名 admin，登录后建议尽快修改）
ADMIN_INITIAL_PASSWORD=strix-admin-123

# 公司 LLM 网关（必填）；API 密钥由各用户在「设置」页配置个人密钥，平台不再持有统一密钥
LLM_API_BASE=
# STRIX_LLM 为平台模型表为空时的最终回退；FREE_MODELS 仅在首次启动（platform_models 表为空）时播种初始模型列表，
# 之后模型列表以数据库为准，由超管在「设置 → 平台模型管理」通过网关密钥查询并添加
STRIX_LLM=free
FREE_MODELS=free,free/MiniMax-M2.7,free/deepseek-v4-flash,free/glm-5.2,free/sensenova-6.8-flash-lite

# RustFS 对象存储密钥（建议修改默认值）
RUSTFS_ACCESS_KEY=strix-platform
RUSTFS_SECRET_KEY=strix-platform-secret

# PostgreSQL 密码（建议修改默认值）
POSTGRES_PASSWORD=strix

# 黑盒目标允许清单（逗号分隔：域名后缀 或 CIDR，如 .test.company.internal,10.0.0.0/8）
TARGET_ALLOWLIST=

# strix 全局附加参数（所有任务生效，可选）
# 单任务 LLM 预算上限（美元）；大于 0 时传 --max-budget，超预算 strix 自行中止（如 5 表示 $5）
STRIX_MAX_BUDGET=0
# 原样追加的额外 CLI 参数（shlex 切分），如 "--scope-mode full --config /etc/strix.json"
STRIX_EXTRA_ARGS=

# 联网搜索（可选）：内网 MCP 搜索端点（Streamable HTTP，可无状态 JSON-RPC 直调）。
# 配置后任务提交时可勾选「联网搜索」（默认不勾选），智能体经沙箱 shell 查询公开漏洞/利用资料。
# 需确认沙箱容器可访问该地址；留空 = 功能关闭
WEB_SEARCH_MCP_URL=http://192.168.1.240:8086/mcp/web_search_prime/mcp
