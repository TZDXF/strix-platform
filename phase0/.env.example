# ===== Phase 0 引擎验证环境配置 =====
# 复制为 .env 并填入真实值。.env 不要提交到任何仓库。

# 公司统一 LLM 网关（OpenAI 兼容），必填
LLM_API_BASE=https://llm-gateway.company.internal/v1

# 网关签发的服务 Key，必填
LLM_API_KEY=sk-xxxx

# 经网关使用的模型（STRIX_LLM 格式为 provider/model），必填
STRIX_LLM=openai/gpt-5.4

# 关闭遥测（内网合规），保持 off
STRIX_TELEMETRY=off

# 可选：Web 搜索能力（perplexity），没有就留空
# PERPLEXITY_API_KEY=

# 可选：任务超时覆盖（秒）。默认 quick=1800 standard=7200 deep=18000
# TIMEOUT_QUICK=1800
# TIMEOUT_STANDARD=7200
# TIMEOUT_DEEP=18000
